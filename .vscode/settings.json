{
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 80,
  "workbench.editor.limit.perEditorGroup": false,
  "workbench.editor.limit.excludeDirty": true,
  "files.exclude": {
    "service_data/**": true,
    "artifacts/**": true,
    "artifacts_*/**": true,
    "data_*/**": true
  },
  "files.watcherExclude": {
    "**/service_data/**": true,
    "/root/stockAgent/service_data/**": true,
    "service_data/**": true,
    "**/artifacts/**": true,
    "**/artifacts_*/**": true,
    "**/data_*/**": true,
    "/root/stockAgent/artifacts/**": true,
    "/root/stockAgent/artifacts_*/**": true,
    "/root/stockAgent/data_*/**": true,
    "artifacts/**": true,
    "artifacts_*/**": true,
    "data_*/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.cache/**": true,
    "**/.venv/**": true
  },
  "js/ts.tsserver.watchOptions": {
    "excludeDirectories": [
      "/root/stockAgent/service_data",
      "/root/stockAgent/service_data/**",
      "/root/stockAgent/artifacts",
      "/root/stockAgent/artifacts/**",
      "/root/stockAgent/artifacts_*",
      "/root/stockAgent/artifacts_*/**",
      "/root/stockAgent/data_*",
      "/root/stockAgent/data_*/**"
    ]
  },
  "search.exclude": {
    "service_data/**": true,
    "artifacts/**": true,
    "artifacts_*/**": true,
    "data_*/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.cache/**": true,
    "**/.venv/**": true
  }
}
