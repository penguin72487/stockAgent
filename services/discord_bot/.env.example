DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Required for U.S. OHLCV refreshes. Obtain Market Data API credentials from Alpaca.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_REQUESTS_PER_MINUTE=200

STOCKAGENT_MARKETS_DIR=services/discord_bot/markets
STOCKAGENT_DEFAULT_MARKET=tw
STOCKAGENT_SCHEDULED_MARKETS=all
STOCKAGENT_BOT_RESTART_DELAY_SECONDS=0
STOCKAGENT_BOT_RELOAD_POLL_SECONDS=0.2
STOCKAGENT_BOT_CRASH_RESTART_DELAY_SECONDS=10

STOCKAGENT_CONFIG=configs/markets/tw.yaml
STOCKAGENT_OUTPUT_DIR=artifacts
STOCKAGENT_FOLD_ID=
STOCKAGENT_CHECKPOINT=
STOCKAGENT_WEIGHTS_PATH=
STOCKAGENT_PANEL_DATE=latest
STOCKAGENT_DEVICE=cuda

STOCKAGENT_PRICE_SOURCE=panel
STOCKAGENT_PRICES_CSV=
STOCKAGENT_TOP_N=20
STOCKAGENT_MIN_ABS_DELTA=0.001
STOCKAGENT_SIGNAL_TIME=13:15
STOCKAGENT_TZ=Asia/Taipei

# TW cash close latency path: arm process-local panel/checkpoint/model caches
# before 13:30, then build a non-official same-session quote preview at 13:30.
# The command response budget is capped below 60 seconds in code.
STOCKAGENT_POSTCLOSE_FAST_ARM_MINUTES=10
STOCKAGENT_POSTCLOSE_FAST_WINDOW_MINUTES=90
STOCKAGENT_POSTCLOSE_FAST_TIMEOUT_SECONDS=50
STOCKAGENT_POSTCLOSE_FAST_QUOTE_CACHE_SECONDS=120
STOCKAGENT_POSTCLOSE_FAST_REQUEST_TIMEOUT_SECONDS=1.5
STOCKAGENT_POSTCLOSE_FAST_CACHE_STATUS_PATH=artifacts/discord_bot/postclose_fast_cache.json
# Applies to both the 09:00 opening gate and the 13:30 provisional-close gate.
STOCKAGENT_TW_OPENING_MIN_COVERAGE=0.90
