[Unit]
Description=StockAgent registered daily market-data completeness refresh
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
Slice=stockagent-heavy-data.slice
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecCondition=/usr/bin/bash "@REPO_ROOT@/scripts/run_outside_tw_opening_resource_window.sh"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_registered_data_refresh.sh" daily
Nice=10
CPUWeight=20
IOWeight=20
MemoryAccounting=true
MemoryHigh=48G
MemoryMax=64G
MemorySwapMax=8G
OOMScoreAdjust=750
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
