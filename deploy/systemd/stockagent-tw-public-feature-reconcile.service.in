[Unit]
Description=Reconcile service-required Taiwan public projection against exact source bytes
After=local-fs.target
# Wake the independent cold publisher only after this oneshot releases the
# canonical source lock.  The publisher still audits every receipt and its
# own opening-window ExecCondition before writing an immutable release.
OnSuccess=stockagent-tw-public-cold-publish.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=__REPO_ROOT__
Environment="HOME=/root"
Environment="PYTHONUNBUFFERED=1"
# Source/service hosts do not routinely build experiment-only research copies.
ExecStart=/usr/bin/bash -lc 'source scripts/runtime_env.sh && run_fintech_python scripts/reconcile_tw_public_training_features.py --defer-market-hours'
Nice=15
CPUWeight=10
IOWeight=10
IOSchedulingClass=idle
MemoryAccounting=true
MemoryHigh=48G
MemoryMax=64G
MemorySwapMax=8G
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__REPO_ROOT__/artifacts /srv/stockagent-live/data_tw_public /srv/stockagent-live/.locks
InaccessiblePaths=-/root/.ssh -/root/.codex -__REPO_ROOT__/.env -__REPO_ROOT__/.env.trade -__REPO_ROOT__/.env.futures
