[Unit]
Description=Refresh Taiwan official macro release originals and reconcile PIT features
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target local-fs.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=__REPO_ROOT__
Environment="HOME=/root"
Environment="PYTHONUNBUFFERED=1"
ExecCondition=/usr/bin/bash __REPO_ROOT__/scripts/run_outside_tw_opening_resource_window.sh --minimum-runway-minutes 45
# The Python producer waits at most 120 seconds for this same lock, then checks
# the protected opening window again. A one-shot preflight would silently skip
# the entire 07:00 release when the eligibility watcher briefly owns it.
ExecStart=/usr/bin/bash -lc 'source scripts/runtime_env.sh && run_fintech_python scripts/refresh_tw_public_release_archives.py --output-dir /srv/stockagent-live/data_tw_public --auto-full-sunday'
Nice=15
CPUWeight=10
IOWeight=10
IOSchedulingClass=idle
MemoryAccounting=true
MemoryHigh=48G
MemoryMax=64G
MemorySwapMax=8G
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__REPO_ROOT__/artifacts /srv/stockagent-live/data_tw_public /srv/stockagent-live/.locks
InaccessiblePaths=-/root/.ssh -/root/.codex -__REPO_ROOT__/.env -__REPO_ROOT__/.env.trade -__REPO_ROOT__/.env.futures
