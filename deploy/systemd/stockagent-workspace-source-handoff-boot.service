[Unit]
Description=Restore journalled StockAgent source aliases on the E workspace
Requires=stockagent-e-workspace-mount.service stockagent-service-layout.service
After=stockagent-e-workspace-mount.service stockagent-service-layout.service
Before=stockagent-registered-data-daily.service stockagent-data-refresh-status-snapshot.service

[Service]
Type=oneshot
WorkingDirectory=/root/stockAgent
ExecStart=/usr/bin/bash -c 'source /root/stockAgent/scripts/runtime_env.sh && run_fintech_python /root/stockAgent/scripts/run_workspace_source_handoff.py --boot'
RemainAfterExit=yes
TimeoutStartSec=infinity
UMask=0077

[Install]
WantedBy=multi-user.target
