[Unit]
Description=Run the unified 08:30 Taiwan official-data acceptance gate
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
# One immediate recovery is useful for transient I/O, while the weekday timer
# owns longer retries.  This prevents six expensive full audits from racing the
# opening inference and also lets the next scheduled checkpoint run normally.
StartLimitIntervalSec=5min
StartLimitBurst=2

[Service]
Type=oneshot
# Day-trade input readiness is not bulk history acquisition.  Give this gate
# its own system-slice share, below the execution and Discord services but
# ahead of background archival and historical work.
Slice=system.slice
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_tw_public_0830_check.sh"
# The Discord scheduler and paper executor retain the more urgent -5 nice
# level.  Resource weights arbitrate contention rather than imposing a quota.
Nice=0
CPUWeight=5000
IOWeight=5000
MemoryAccounting=true
# Do not block required inputs with the bulk-acquisition capacity policy.
MemoryHigh=infinity
MemoryMax=infinity
MemorySwapMax=infinity
OOMScoreAdjust=-250
TasksMax=infinity
TimeoutStartSec=4h
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
