[Unit]
Description=Reconcile the published day-trade projection with selected source heads
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
Slice=system.slice
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_finlab_daytrade_priority.sh" reconcile
SuccessExitStatus=75
Nice=-3
CPUWeight=5000
IOWeight=5000
OOMScoreAdjust=-250
TimeoutStartSec=4h
