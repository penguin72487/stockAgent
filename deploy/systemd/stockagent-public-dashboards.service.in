[Unit]
Description=StockAgent sanitized read-only public dashboard gateway
Wants=stockagent-shioaji-taifex-dashboard.service stockagent-tw-day-trade-simulation.service
After=stockagent-shioaji-taifex-dashboard.service stockagent-tw-day-trade-simulation.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=__REPO_ROOT__
Environment="HOME=/root"
Environment="PYTHONUNBUFFERED=1"
Environment="MALLOC_ARENA_MAX=2"
Environment="STOCKAGENT_DASHBOARD_INDEX_CACHE_DIR=/var/cache/stockagent-public-dashboards"
CacheDirectory=stockagent-public-dashboards
CacheDirectoryMode=0700
ExecStart=/usr/bin/bash "__REPO_ROOT__/scripts/run_public_dashboards.sh"
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=-/root/.ssh -/root/.codex -__REPO_ROOT__/.env -__REPO_ROOT__/.env.trade -__REPO_ROOT__/.env.futures
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
