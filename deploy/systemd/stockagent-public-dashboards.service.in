[Unit]
Description=StockAgent sanitized read-only public dashboard gateway
Wants=stockagent-shioaji-taifex-dashboard.service stockagent-tw-day-trade-simulation.service stockagent-tw-overnight-simulation.service
After=stockagent-shioaji-taifex-dashboard.service stockagent-tw-day-trade-simulation.service stockagent-tw-overnight-simulation.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=__REPO_ROOT__
Environment="HOME=/root"
Environment="PYTHONUNBUFFERED=1"
Environment="MALLOC_ARENA_MAX=2"
Environment="STOCKAGENT_DASHBOARD_INDEX_CACHE_DIR=/var/cache/stockagent-public-dashboards"
Environment="STOCKAGENT_DASHBOARD_PERFORMANCE_DIR=/var/lib/stockagent-public-dashboards/performance"
CacheDirectory=stockagent-public-dashboards
CacheDirectoryMode=0700
StateDirectory=stockagent-public-dashboards
StateDirectoryMode=0700
ExecStart=/usr/bin/bash "__REPO_ROOT__/scripts/run_public_dashboards.sh"
ExecStartPost=/usr/bin/bash "__REPO_ROOT__/scripts/wait_public_dashboard_ready.sh"
TimeoutStartSec=70s
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
KillMode=control-group
# Keep headroom for complete history and concurrent detail projections.  On
# 2026-09-25 the running gateway reached 3.38 GiB (below MemoryHigh=4G, with
# zero high/oom events); an older below-1-GiB observation is not the current
# sizing basis.  Re-measure before changing either boundary.  TasksMax is an
# OS safety boundary, not an application rate or 32-request concurrency limit.
MemoryAccounting=true
MemoryHigh=4G
MemoryMax=8G
MemorySwapMax=1G
TasksMax=4096
OOMScoreAdjust=-250
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=-/root/.ssh -/root/.codex -__REPO_ROOT__/.env -__REPO_ROOT__/.env.trade -__REPO_ROOT__/.env.futures
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @resources @swap
SystemCallErrorNumber=EPERM
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
