[Unit]
Description=Audit StockAgent Git content and push completed twRule commits
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO_ROOT__
StateDirectory=stockagent/daily-git
StateDirectoryMode=0700
UMask=0077
Environment="GH_CONFIG_DIR=__GH_CONFIG_DIR__"
Environment=GIT_TERMINAL_PROMPT=0
ExecStart=/usr/bin/bash -ec 'source "__PROGRAM_DIR__/runtime_env.sh" && exec_fintech_python "__PROGRAM_DIR__/maintain_git_daily.py" --repo "__REPO_ROOT__" --state-dir /var/lib/stockagent/daily-git --apply'
TimeoutStartSec=300
SuccessExitStatus=75
