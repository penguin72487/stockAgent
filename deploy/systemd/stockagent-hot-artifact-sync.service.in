[Unit]
Description=Direct local-authoritative StockAgent hot artifact synchronization
Wants=network-online.target syncthing@root.service
After=network-online.target syncthing@root.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_live_artifact_sync.sh" --sync-root /srv/stockagent-artifacts-hot --status-path /var/lib/stockagent-hot-artifact-sync/status.json
Restart=always
RestartSec=2s
Nice=5
CPUWeight=50
IOWeight=50
StateDirectory=stockagent-hot-artifact-sync
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
