[Unit]
Description=CPU-only deadline and post-close wakeup for canonical Discord artifact workers
After=time-sync.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"
StateDirectory=stockagent-discord-artifact-retry
Environment="STOCKAGENT_ARTIFACT_RETRY_STATE_PATH=/var/lib/stockagent-discord-artifact-retry/latest.json"
# Only the bounded source-only worker may run during preopen; ordinary
# historical inference keeps its original protected-runway admission.
Environment="STOCKAGENT_PREOPEN_PRIORITY_SOURCE=1"
# The controller enforces each owner's own runway: latest-close 13m, history
# 123m. Never put model inference here or let the 2h history gate mask a close.
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_discord_artifact_maintenance.sh" --request-due-work
TimeoutStartSec=30s
# This lightweight controller wakes the source-only preopen owner; delaying
# the controller under load can otherwise prevent the higher-priority repair.
Nice=-5
CPUWeight=10000
IOWeight=10000
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
