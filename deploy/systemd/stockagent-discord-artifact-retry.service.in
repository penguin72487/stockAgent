[Unit]
Description=CPU-only deadline and post-close wakeup for canonical Discord artifact workers
After=time-sync.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"
StateDirectory=stockagent-discord-artifact-retry
Environment="STOCKAGENT_ARTIFACT_RETRY_STATE_PATH=/var/lib/stockagent-discord-artifact-retry/latest.json"
# The controller enforces each owner's own runway: latest-close 13m, history
# 123m. Never put model inference here or let the 2h history gate mask a close.
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_discord_artifact_maintenance.sh" --request-due-work
TimeoutStartSec=30s
Nice=15
CPUWeight=10
IOWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
