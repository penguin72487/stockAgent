[Unit]
Description=StockAgent four-mode Taiwan stock day-trade paper execution and dashboard
Wants=network-online.target time-sync.target stockagent-discord-bot.service
After=network-online.target time-sync.target stockagent-discord-bot.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_tw_day_trade_services.sh"
Nice=5
CPUWeight=25
IOWeight=25
Restart=on-failure
RestartSec=5s
SuccessExitStatus=143 SIGTERM
TimeoutStopSec=20s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
