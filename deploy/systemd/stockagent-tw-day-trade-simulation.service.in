[Unit]
Description=StockAgent Taiwan stock day-trade paper execution and dashboard
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
Before=stockagent-discord-bot.service stockagent-public-dashboards.service
StartLimitIntervalSec=60
StartLimitBurst=20

[Service]
Type=notify
NotifyAccess=all
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_tw_day_trade_services.sh"
Nice=-5
CPUWeight=100
IOWeight=100
# Preserve the stateful paper execution engine ahead of reproducible bulk
# refresh/audit workers when the kernel must select an OOM victim.
OOMScoreAdjust=-500
# Measured peak was below 1 GiB.  Keep wide headroom for model/config growth,
# but contain a leak inside this restartable cgroup instead of the whole host.
MemoryAccounting=true
MemoryHigh=8G
MemoryMax=16G
MemorySwapMax=2G
TasksMax=2048
Restart=always
RestartSec=1s
# Historical 09:01 recovery is a bounded request/reply batch.  Individual
# Shioaji Tick calls may legitimately wait up to 30s, while the in-process
# opening path keeps its tighter progress checks.  Keep the outer process
# watchdog above that legitimate blocking interval.
WatchdogSec=90s
TimeoutStartSec=60s
SuccessExitStatus=143 SIGTERM
TimeoutStopSec=20s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
