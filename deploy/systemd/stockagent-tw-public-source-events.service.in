[Unit]
Description=Monitor and ingest version events from every Taiwan official public dataset
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_tw_public_source_event_monitor.sh"
Restart=always
RestartSec=5s
WatchdogSec=5min
TimeoutStartSec=1min
# Source updates feed the opening path.  Give them a larger share than bulk
# collection, while the paper executor and Discord retain first priority.
Nice=0
CPUWeight=5000
IOWeight=5000
# Prefer killing/restarting reproducible bulk maintenance before this
# stateful event monitor when the host is under memory pressure.
OOMScoreAdjust=-250
MemoryAccounting=true
# Rebuilds may temporarily be large; do not impose the bulk-job ceilings on
# the day-trade source owner.  The executor remains separately protected.
MemoryHigh=infinity
MemoryMax=infinity
MemorySwapMax=infinity
TasksMax=infinity
TimeoutStopSec=2min

[Install]
WantedBy=multi-user.target
