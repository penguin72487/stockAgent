[Unit]
Description=Publish exact requested packed payloads to the enrolled Vast edge
Requires=stockagent-d-cold-mount.service
Wants=network-online.target syncthing@root.service
After=stockagent-d-cold-mount.service network-online.target syncthing@root.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=__REPO_ROOT__
Environment="HOME=/root"
ExecStart=/usr/bin/bash -c 'set -a; source /etc/stockagent/remote-cold-artifact-ingress.env; set +a; source "__REPO_ROOT__/scripts/runtime_env.sh"; run_fintech_python "__REPO_ROOT__/scripts/manage_packed_transport.py" --apply'
UMask=0077
Nice=19
CPUWeight=1
IOWeight=1
IOSchedulingClass=idle
TimeoutStartSec=3min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=no
