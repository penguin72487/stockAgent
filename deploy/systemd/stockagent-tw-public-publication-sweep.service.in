[Unit]
Description=Refresh official Taiwan public datasets at a publication boundary
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_tw_public_publication_sweep.sh"
Nice=5
CPUWeight=50
IOWeight=50
TimeoutStartSec=2h

[Install]
WantedBy=multi-user.target
