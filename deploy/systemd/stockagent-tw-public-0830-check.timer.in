[Unit]
Description=Accept and publish all Taiwan official data before 08:30

[Timer]
OnCalendar=Mon..Fri *-*-* 08:00:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 08:15:00 Asia/Taipei
# The measured full audit plus 104,749-file verification takes about 184s.
# Start the final bounded attempt with six minutes of deadline budget.
OnCalendar=Mon..Fri *-*-* 08:24:00 Asia/Taipei
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=stockagent-tw-public-0830-check.service

[Install]
WantedBy=timers.target
