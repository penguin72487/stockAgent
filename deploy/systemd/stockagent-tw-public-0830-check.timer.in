[Unit]
Description=Check and publish all Taiwan official data at 08:30

[Timer]
OnCalendar=Mon..Fri *-*-* 08:20:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 08:30:00 Asia/Taipei
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=stockagent-tw-public-0830-check.service

[Install]
WantedBy=timers.target
