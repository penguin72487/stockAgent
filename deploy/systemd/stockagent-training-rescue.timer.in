[Unit]
Description=Observe enrolled training recovery state every 30 seconds

[Timer]
# WSL can restart userspace while its shared kernel remains up. Start this
# owner after each timer activation, including such warm reboots.
OnActiveSec=45s
OnUnitInactiveSec=30s
AccuracySec=1s
Persistent=true
Unit=stockagent-training-rescue.service

[Install]
WantedBy=timers.target
