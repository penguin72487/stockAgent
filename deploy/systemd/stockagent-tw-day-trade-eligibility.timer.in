[Unit]
Description=Watch for next-session day-trade eligibility at the official release time

[Timer]
OnCalendar=Mon..Fri *-*-* 22:29:55 Asia/Taipei
# Weekly morning catch-up points are deliberate.  A clean host shutdown after
# the night trigger is not a service failure, so Restart=on-failure cannot
# recover it; each weekday must independently prove today's exact-session file.
OnCalendar=Mon..Fri *-*-* 05:30:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 07:30:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 08:00:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 08:25:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 08:50:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 09:00:05 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 09:05:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 09:15:00 Asia/Taipei
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=stockagent-tw-day-trade-eligibility.service

[Install]
WantedBy=timers.target
