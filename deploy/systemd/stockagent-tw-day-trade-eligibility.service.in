[Unit]
Description=Fetch exact-session TWSE and TPEx day-trade eligibility on publication
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
# A pending official release already waits up to 90 minutes inside one run.
# Bound immediate crash loops separately from publication-time retries.
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_tw_day_trade_eligibility_watcher.sh"
# Exact-session eligibility feeds day-trade execution and must take precedence
# over historical downloads and storage maintenance.
Nice=0
CPUWeight=10000
IOWeight=10000
TimeoutStartSec=2h
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
