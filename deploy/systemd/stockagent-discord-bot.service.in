[Unit]
Description=StockAgent Discord Gateway and live scheduled signal service
Wants=network-online.target time-sync.target stockagent-tw-day-trade-simulation.service stockagent-tw-overnight-simulation.service
After=network-online.target time-sync.target stockagent-tw-day-trade-simulation.service stockagent-tw-overnight-simulation.service
StartLimitIntervalSec=60
StartLimitBurst=20

[Service]
Type=notify
NotifyAccess=all
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_discord_bot.sh"
Restart=always
RestartSec=1s
# Full-universe panel/model native calls can hold the Python event-loop thread
# for tens of seconds even though their bounded worker is progressing.  Keep
# this outer process watchdog above that observed stall; the opening scheduler
# retains its tighter progress-aware 30s/180s watchdogs.
WatchdogSec=90s
TimeoutStartSec=60s
TimeoutStopSec=30s
KillMode=control-group
# The same long-lived process owns the 09:00 and 13:30 deadline paths. Give it
# precedence over download/backfill maintenance when the host is contended;
# application-level guards still defer non-critical bot work at those windows.
Nice=-5
CPUWeight=200
IOWeight=200
# The Gateway and live command plane must survive best-effort maintenance OOM.
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
