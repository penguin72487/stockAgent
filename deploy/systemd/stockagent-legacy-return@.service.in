[Unit]
Description=Resume the retained Vast legacy return cohort %i
Requires=stockagent-d-cold-mount.service
Wants=network-online.target syncthing@root.service
After=stockagent-d-cold-mount.service network-online.target syncthing@root.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=__REPO_ROOT__
Environment="HOME=/root"
ExecCondition=/usr/bin/bash __REPO_ROOT__/scripts/run_remote_legacy_archive_return.sh --cohort %i --check-ready
ExecStart=/usr/bin/bash -c 'set -a; source /etc/stockagent/remote-cold-artifact-ingress.env; set +a; exec /usr/bin/bash "__REPO_ROOT__/scripts/run_remote_legacy_archive_return.sh" --cohort %i archive --apply --order reclaim-first'
UMask=0077
Nice=19
CPUWeight=1
IOWeight=1
IOSchedulingClass=idle
TimeoutStartSec=infinity
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=no
