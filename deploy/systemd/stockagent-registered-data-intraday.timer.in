[Unit]
Description=Refresh registered crypto data one minute after each completed cycle

[Timer]
# Timer activation, including late WSL recovery, is the sole bootstrap clock.
# An overdue OnBootSec can fire immediately when an elapsed timer is rearmed.
OnActiveSec=1min
OnUnitInactiveSec=1min
Persistent=true
Unit=stockagent-registered-data-intraday.service

[Install]
WantedBy=timers.target
