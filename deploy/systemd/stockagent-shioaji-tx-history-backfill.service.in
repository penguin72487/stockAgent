[Unit]
Description=StockAgent resumable all-Shioaji-futures historical Tick backfill
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target stockagent-shioaji-taifex-bidask.service stockagent-shioaji-top200.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecCondition=/usr/bin/bash "@REPO_ROOT@/scripts/run_outside_tw_opening_resource_window.sh" --minimum-runway-minutes 35 --protected-until 14:31
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_shioaji_tx_history_backfill.sh"
Nice=10
CPUWeight=25
IOWeight=25
Restart=on-failure
RestartSec=300s
TimeoutStopSec=90s
KillMode=control-group
