[Unit]
Description=Compare the fixed futures E copy with the fixed D inventory
Requires=stockagent-e-workspace-mount.service stockagent-service-layout.service
After=stockagent-e-workspace-mount.service stockagent-service-layout.service

[Service]
Type=oneshot
WorkingDirectory=/root/stockAgent
ExecStart=/usr/bin/bash -c 'source /root/stockAgent/scripts/runtime_env.sh && run_fintech_python /root/stockAgent/scripts/check_futures_e_cold_inventory.py'
SuccessExitStatus=75
TimeoutStartSec=infinity
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

