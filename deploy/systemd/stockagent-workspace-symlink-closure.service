[Unit]
Description=Verify fixed E source-copy symlink targets without retiring originals
Requires=stockagent-e-workspace-mount.service stockagent-service-layout.service
After=stockagent-e-workspace-mount.service stockagent-service-layout.service

[Service]
Type=oneshot
WorkingDirectory=/root/stockAgent
ExecStart=/usr/bin/bash -c 'source /root/stockAgent/scripts/runtime_env.sh && run_fintech_python /root/stockAgent/scripts/check_workspace_symlink_closure.py'
SuccessExitStatus=75
TimeoutStartSec=infinity
UMask=0077
Nice=10

