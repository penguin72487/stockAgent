[Unit]
Description=StockAgent FinMind Sponsor all-market history
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
Slice=stockagent-heavy-data.slice
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_finmind_sponsor.sh"
Restart=on-failure
RestartSec=60s
Nice=10
CPUWeight=20
IOWeight=20
MemoryAccounting=true
MemoryHigh=2G
MemoryMax=4G
OOMScoreAdjust=700

[Install]
WantedBy=multi-user.target
