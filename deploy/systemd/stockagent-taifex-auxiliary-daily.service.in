[Unit]
Description=StockAgent TAIFEX options, recent ticks, and settlement refresh
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target stockagent-taifex-futures-daily.service

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_taifex_auxiliary_daily.sh"
Nice=10
CPUWeight=20
IOWeight=20
TimeoutStartSec=2h

[Install]
WantedBy=multi-user.target
