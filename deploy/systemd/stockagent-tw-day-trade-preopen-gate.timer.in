[Unit]
Description=Verify Taiwan stock paper simulation before and after the 09:01 execution gate

[Timer]
OnCalendar=Mon..Fri *-*-* 08:50:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 08:56:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 08:58:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 08:59:30 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 09:00:15 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 09:00:30 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 09:01:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 09:01:15 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 09:02:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 09:03:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 09:05:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 09:10:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 09:15:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 09:30:00 Asia/Taipei
OnCalendar=Mon..Fri *-*-* 10:00:00 Asia/Taipei
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=stockagent-tw-day-trade-preopen-gate.service

[Install]
WantedBy=timers.target
