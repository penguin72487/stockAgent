[Unit]
Description=StockAgent FinMind free complementary history
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
Slice=stockagent-heavy-data.slice
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_finmind_complement.sh"
Restart=on-failure
RestartSec=60s
Nice=0
CPUWeight=100
IOWeight=100
MemoryAccounting=true
MemoryHigh=12G
MemoryMax=20G
OOMScoreAdjust=700

[Install]
WantedBy=multi-user.target
