[Unit]
Description=StockAgent FinLab account-scoped local research history refresh
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
Slice=stockagent-heavy-data.slice
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecCondition=/usr/bin/bash "@REPO_ROOT@/scripts/run_outside_tw_opening_resource_window.sh" --official-calendar-root "@REPO_ROOT@/data_tw_public"
ExecStartPre=/usr/bin/bash -n "@REPO_ROOT@/scripts/run_finlab_refresh_frozen.sh"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_finlab_refresh_frozen.sh"
Nice=10
CPUWeight=20
IOWeight=20
MemoryAccounting=true
# Exact live cgroup evidence on 2026-09-26: the 6 GiB soft limit caused
# sustained ~90% memory.full stalls for a single SDK key while the host had
# >80 GiB available. Keep the 10 GiB hard stop and zero swap; allow a bounded
# 2 GiB larger working set before reclaim.
MemoryHigh=8G
MemoryMax=10G
MemorySwapMax=0
OOMScoreAdjust=700
TimeoutStartSec=4h

[Install]
WantedBy=multi-user.target
