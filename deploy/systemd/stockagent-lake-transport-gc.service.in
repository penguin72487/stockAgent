[Unit]
Description=Retire one exact NAS-accepted immutable transport wave
Requires=stockagent-d-cold-mount.service stockagent-backup-transport-mount.service
After=stockagent-d-cold-mount.service stockagent-backup-transport-mount.service

[Service]
Type=oneshot
WorkingDirectory=__REPO_ROOT__
ExecStart=/bin/bash __REPO_ROOT__/scripts/run_lakehouse_control.sh python scripts/retire_lake_transport_cache.py
TimeoutStartSec=10min
SuccessExitStatus=75
UMask=0077
CPUQuota=50%
MemoryMax=256M
Nice=19
IOSchedulingClass=best-effort
IOSchedulingPriority=7
Environment=PYTHONDONTWRITEBYTECODE=1
