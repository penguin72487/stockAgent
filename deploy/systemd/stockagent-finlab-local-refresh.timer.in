[Unit]
Description=Refresh licensed FinLab research cache after quota reset and TW opening

[Timer]
# Seed the relative retry after boot or timer activation. A last deactivation
# from a previous boot cannot schedule OnUnitInactiveSec in this boot.
# Existing ExecCondition gates still decide whether any source work is due.
OnActiveSec=1min
OnCalendar=*-*-* 07:00:05 Asia/Taipei
OnCalendar=*-*-* 08:00:05 Asia/Taipei
OnCalendar=*-*-* 08:03:00 Asia/Taipei
OnCalendar=*-*-* 09:10:05 Asia/Taipei
OnCalendar=*-*-* 16:10:00 Asia/Taipei
# Once a bounded pass exits, retry eligible failures and newly due source
# checks during the same day. A cheap local ExecCondition skips idle sweeps;
# the service lock, actual account reset and opening-window gate remain.
OnUnitInactiveSec=1min
AccuracySec=1s
Persistent=true
Unit=stockagent-finlab-local-refresh.service

[Install]
WantedBy=timers.target
