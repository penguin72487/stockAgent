[Unit]
Description=Verify final Taiwan stock day-trade paper-simulation preopen readiness
Wants=network-online.target time-sync.target stockagent-discord-bot.service stockagent-tw-day-trade-simulation.service
After=network-online.target time-sync.target stockagent-discord-bot.service stockagent-tw-day-trade-simulation.service

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPO_ROOT@
Environment="HOME=@SERVICE_HOME@"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/bash "@REPO_ROOT@/scripts/run_tw_day_trade_preopen_gate.sh"
Nice=0
CPUWeight=100
IOWeight=100
TimeoutStartSec=2min
NoNewPrivileges=true
PrivateTmp=true
