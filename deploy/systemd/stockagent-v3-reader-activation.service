[Unit]
Description=Enable fixed E dedup candidates after pinned Vast reader observation
Requires=stockagent-e-workspace-mount.service stockagent-service-layout.service
After=stockagent-e-workspace-mount.service stockagent-service-layout.service

[Service]
Type=oneshot
WorkingDirectory=/root/stockAgent
Environment=STOCKAGENT_V3_READER_ACTIVATION_APPLY=1
Environment=STOCKAGENT_TRADING_PRIORITY_GUARD=1
ExecCondition=/bin/bash -c 'source scripts/runtime_env.sh; run_fintech_python scripts/check_outside_tw_opening_resource_window.py --minimum-runway-minutes 120 --protected-until 13:30 --official-calendar-root data_tw_public'
ExecStart=/bin/bash /root/stockAgent/scripts/run_authority_storage_operation.sh scripts/run_v3_reader_activation_queue.py
TimeoutStartSec=3min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
