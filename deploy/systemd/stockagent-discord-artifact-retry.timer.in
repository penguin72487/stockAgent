[Unit]
Description=Recover due Discord work with a model-free receipt probe

[Timer]
# A receipt-only probe; no Torch imports, inference or receipt writes when idle.
OnCalendar=*-*-* *:*:00 Asia/Taipei
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=stockagent-discord-artifact-retry.service

[Install]
WantedBy=timers.target
