[Unit]
Description=Reuse the fixed Shioaji minute validation cache after WSL device renumbering
Requires=stockagent-e-workspace-mount.service
After=stockagent-e-workspace-mount.service

[Service]
Type=oneshot
WorkingDirectory=/root/stockAgent
ExecStart=/usr/bin/bash -c 'source /root/stockAgent/scripts/runtime_env.sh && run_fintech_python /root/stockAgent/scripts/rebind_shioaji_validation_cache.py --drain'
TimeoutStartSec=infinity
UMask=0077
Nice=19
IOSchedulingClass=idle
CPUQuota=50%

