# Copy this file to .env. Never commit .env; keep it mode 0600.
# This is the canonical slot list for stockAgent downloaders, including OpenBB.

# Taiwan broker and market data
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=

# U.S. and global market-data providers
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=
NASDAQ_DATA_LINK_API_KEY=

# Official macroeconomic and government APIs used outside OpenBB
BEA_API_KEY=
API_DATA_GOV_KEY=
CENSUS_API_KEY=

# Weather, climate, disasters, energy, environment, and transport
NOAA_CDO_TOKEN=
CWA_API_KEY=
MOENV_API_KEY=
NASA_FIRMS_MAP_KEY=
AIRNOW_API_KEY=
ENTSOE_TOKEN=
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Copernicus ERA5 and Sentinel
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
COPERNICUS_DATASPACE_CLIENT_ID=
COPERNICUS_DATASPACE_CLIENT_SECRET=

# Agriculture, trade, and entity mapping
USDA_NASS_API_KEY=
UN_COMTRADE_API_KEY=
OPENFIGI_API_KEY=

# Policy, health, innovation, and developer activity
OPENFDA_API_KEY=
GITHUB_TOKEN=

# SEC does not use an API key. Fair-access requires an identifiable
# name / organization / email. Configure either the full User-Agent or the
# fallback contact email; these values are configuration, not secrets.
SEC_USER_AGENT='你的名字 你的組織 your-email@example.com'
STOCKAGENT_CONTACT_EMAIL=

# Crypto and on-chain providers
ETHERSCAN_API_KEY=
DUNE_API_KEY=
COINGECKO_DEMO_API_KEY=
COINGLASS_API_KEY=
COINMARKETCAP_API_KEY=

# OpenBB provider credentials. The archive loader maps these into OpenBB's
# lower-case runtime credential fields. Existing process variables override
# this file; ~/.openbb_platform/user_settings.json is legacy fallback only.
FRED_API_KEY=
BLS_API_KEY=
EIA_API_KEY=
CONGRESS_GOV_API_KEY=
FMP_API_KEY=
TIINGO_TOKEN=
BENZINGA_API_KEY=
INTRINIO_API_KEY=
ECONDB_API_KEY=
TRADINGECONOMICS_API_KEY=
CFTC_APP_TOKEN=

# cftc_app_token is retained only for OpenBB compatibility; the current CFTC
# downloader intentionally uses the anonymous official public API.
