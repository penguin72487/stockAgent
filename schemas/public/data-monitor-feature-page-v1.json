{
  "$ref": "#/$defs/FeaturePagePayload",
  "$defs": {
    "FeaturePagePayload": {
      "title": "FeaturePagePayload",
      "type": "object",
      "properties": {
        "filters": {
          "type": "object"
        },
        "generated_at_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "has_more": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "matching_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "production_control_possible": {
          "const": false
        },
        "read_only": {
          "const": true
        },
        "reset_required": {
          "type": "boolean"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "schema_version": {
          "enum": [
            1
          ]
        },
        "summary": {
          "type": "object"
        }
      },
      "required": [
        "filters",
        "generated_at_utc",
        "has_more",
        "limit",
        "matching_total",
        "offset",
        "production_control_possible",
        "read_only",
        "reset_required",
        "revision",
        "rows",
        "schema_version",
        "summary"
      ]
    }
  }
}
