      "role": "cold-audit",
      "publish": true,
      "pack_buckets": 128,
      "loose_threshold_mib": 8,
      "active_process_substrings": [
        "stream_shioaji_tw_microstructure.py",
        "stream_shioaji_taifex_bidask.py"
      ],
      "note": "Raw immutable capture parts; prefer the one-file-per-symbol compactor for analytical reads."
