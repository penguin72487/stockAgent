{
  "schema_version": 1,
  "datasets": [
    {
      "dataset": "tw-public",
      "source": "data_tw_public",
      "role": "training-and-audit",
      "publish": true,
      "pack_buckets": 64,
      "loose_threshold_mib": 8,
      "active_process_substrings": [
        "download_tw_public_data.py",
        "rebuild_tw_public_data_layer.py",
        "build_tw_public_training_features.py"
      ],
      "note": "Immutable public TW training tree plus official raw receipts."
    },
    {
      "dataset": "tw-minute-train",
      "source": "data_tw_minute/research_dataset",
      "role": "training",
      "publish": true,
      "pack_buckets": 64,
      "loose_threshold_mib": 8,
      "active_process_substrings": [
        "build_shioaji_tw_minute_dataset.py"
      ],
      "note": "Canonical audited one-minute partitions; excludes the known schema2 volume-bug quarantine tree."
    },
    {
      "dataset": "tw-minute-source-cold",
      "source": "data_tw_minute/shioaji_1m",
      "role": "cold-audit",
      "publish": true,
      "pack_buckets": 128,
      "loose_threshold_mib": 8,
      "active_process_substrings": [
        "download_shioaji_tw_minute_kbars.py"
      ],
      "note": "Resumable source chunks and receipts; pack only after downloader exit."
    },
    {
      "dataset": "tw-microstructure-train",
