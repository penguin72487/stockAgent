{
  "contract_version": 1,
  "root": "data_news_fulltext",
  "user_agent": "StockAgentNewsResearch/1.0 (private research; respects robots.txt)",
  "workers": 2,
  "exclusive_http_owner": true,
  "request_timeout_seconds": 8,
  "response_deadline_seconds": 20,
  "max_response_bytes": 8388608,
  "max_attempts": 6,
  "lease_seconds": 300,
  "min_free_disk_bytes": 26843545600,
  "batch_articles": 16,
  "batch_text_bytes": 4194304,
  "robots_ttl_seconds": 86400,
  "metadata_refresh_seconds": 900,
  "recent_article_recheck_seconds": 21600,
  "recent_article_window_days": 3,
  "unknown_source_policy": "awaiting_authorization",
  "collection_purpose": "personal_research",
  "publish": false,
  "remote_training_export": false,
  "providers": [
    {
      "id": "tainan_gov",
      "name": "臺南市政府官方新聞",
      "domains": ["www.tainan.gov.tw"],
      "enabled": true,
      "acquisition_mode": "finite",
      "interval_seconds": 2,
      "parallelism": 1,
      "html_parser": "lxml",
      "article_path_pattern": "(?ai)^/news_content[.]aspx$",
      "require_configured_container": true,
      "embedded_article_layout": "tainan_visible_news_v1",
      "article_selectors": [".area-essay.page-caption-p .essay .p"],
      "title_selector": ".simple-text.title h3",
      "require_author_attribution": true,
      "index_pages": ["https://www.tainan.gov.tw/"],
      "index_path_pattern": "^/$",
      "authorization": {
        "kind": "open_license",
        "license": "Tainan-Government-Website-Open-Information-Announcement",
        "evidence_url": "https://www.tainan.gov.tw/cp.aspx?n=13612",
        "additional_evidence_urls": ["https://origin-www.tainan.gov.tw/cp.aspx?n=13612"],
        "scope": "Bounded diagnosis of public agency-owned official text; preserve provenance and attribution, exclude specially restricted or third-party works and media. The official policy copy is evidence only, not an alternate article access host. No publication or automatic training export.",
        "verified_on": "2026-10-09"
      }
    },
    {
      "id": "kmdn",
      "name": "金門日報",
      "domains": ["www.kmdn.gov.tw"],
      "enabled": true,
      "acquisition_mode": "finite",
      "interval_seconds": 2,
      "parallelism": 1,
      "html_parser": "lxml",
      "article_path_pattern": "^/1117/1271/(?:1272|287081)/[1-9][0-9]*/?$",
      "require_configured_container": true,
      "embedded_article_layout": "kmdn_visible_article_v1",
      "article_selectors": ["section.cp"],
      "title_selector": "h2.title",
      "exclude_selectors": [".pic.pic_block"],
      "require_author_attribution": true,
      "index_pages": ["https://www.kmdn.gov.tw/"],
      "index_path_pattern": "^/$",
      "authorization": {
        "kind": "personal_research",
        "evidence_url": "https://www.kmdn.gov.tw/1119/1120/1409/",
        "additional_evidence_urls": ["https://www.kmdn.gov.tw/"],
        "scope": "Bounded private reading diagnosis of four locally known public articles. RSS explicitly permits reading, not redistribution; retain individual credits and original rights. No paid/member extraction, republication, media capture or automatic training export; this is not a government-wide open-license assumption or a legal fair-use verdict.",
        "reviewed_on": "2026-10-09",
        "automated_access_review": "no_explicit_prohibition_identified",
        "rights_restrictions": "Government hostname does not make newspaper authors' works public domain. All rights retained; full source automation remains a candidate until current access, article scope and attribution are verified."
      }
    }
  ]
}
