{
  "contract_version": 1,
  "root": "data_news_fulltext",
  "user_agent": "StockAgentNewsResearch/1.0 (private research; respects robots.txt)",
  "collection_purpose": "personal_research",
  "publish": false,
  "remote_training_export": false,
  "unknown_source_policy": "awaiting_authorization",
  "workers": 1,
  "exclusive_http_owner": true,
  "request_timeout_seconds": 15,
  "response_deadline_seconds": 25,
  "max_response_bytes": 8388608,
  "max_attempts": 6,
  "lease_seconds": 300,
  "min_free_disk_bytes": 26843545600,
  "batch_articles": 64,
  "batch_text_bytes": 4194304,
  "robots_ttl_seconds": 86400,
  "metadata_refresh_seconds": 900,
  "recent_article_recheck_seconds": 21600,
  "recent_article_window_days": 3,
  "adaptive_rate": {"enabled": false},
  "providers": [{
    "id": "moneyweekly",
    "name": "理財周刊診斷：不是另一路下載器",
    "domains": ["moneyweekly.com.tw"],
    "enabled": true,
    "acquisition_mode": "finite",
    "authorization": {
      "kind": "personal_research",
      "evidence_url": "https://www.moneyweekly.com.tw/ArticleData/Info/%E7%BD%AE%E5%BA%95%E6%96%87%E7%AB%A0/7",
      "scope": "Bounded diagnosis of at most five explicitly selected public article/legacy-route responses per run; retain private original source/byline/clock only for reviewed publisher authors, exclude unknown/third-party, member and paid bodies; no redistribution or training injection",
      "reviewed_on": "2026-10-09",
      "automated_access_review": "no_explicit_prohibition_identified",
      "original_author_scope_evidence_urls": ["https://www.moneyweekly.com.tw/ArticleData/Info/Article/254394", "https://www.moneyweekly.com.tw/ArticleData/Info/Article/254340", "https://www.moneyweekly.com.tw/Home/ChangePage/Article/195112/"]
    },
    "interval_seconds": 2,
    "parallelism": 1,
    "html_parser": "lxml",
    "article_path_pattern": "^/ArticleData/Info/Article/[0-9]+/?$",
    "article_selectors": [".div_Article_Info[itemprop=articleBody]"],
    "title_selector": "h1",
    "require_configured_container": true,
    "require_author_attribution": true,
    "author_selectors": ["h1 + div > div:nth-child(2)"],
    "permitted_author_names": ["理周投研部", "洪崇晏"],
    "publication_selectors": ["h1 + div > div:first-child"],
    "exclude_selectors": ["[data-widget_id]"],
    "note": "Exact source container and adjacent byline/date verified on two 200 responses. Diagnostic replay only; no whole-page, summary or third-party body acceptance. Canonical NewsHTTP owns robots, public-address checks, persisted circuits and source pacing."
  }]
}
