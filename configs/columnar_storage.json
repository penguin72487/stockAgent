{
  "schema_version": 1,
  "canonical_fact_format": "parquet",
  "canonical_compression": {
    "codec": "zstd",
    "level": 3,
    "cold_level": 6,
    "statistics": true
  },
  "targets": {
    "interactive_file_bytes_min": 67108864,
    "interactive_file_bytes_max": 268435456,
    "cold_file_bytes_max": 536870912,
    "row_group_uncompressed_bytes_min": 67108864,
    "row_group_uncompressed_bytes_max": 134217728,
    "fallback_row_group_rows": 122880
  },
  "engine_roles": {
    "duckdb": ["cross_file_sql", "joins", "aggregations", "compaction", "query_views"],
    "polars_lazy": ["canonical_etl", "feature_engineering", "panel_build"],
    "polars_streaming": ["bounded_memory_etl", "oversized_result_sink"],
    "pyarrow": ["schema_contract", "parquet_metadata", "projection", "atomic_write_validation"],
    "numpy_memmap": ["rebuildable_dense_training_cache"],
    "sqlite_wal": ["transactional_download_manifest", "resume_state"]
  },
  "layers": {
    "l0": "immutable provider/task shards retained for resumability and audit",
    "l1": "append-only compact segments; no source deletion",
    "l2": "optional final partitioned canonical release after complete parity audit"
  },
  "dataset_version_lifecycle": {
    "enabled": true,
    "completed_source_budget_per_activity": 1,
    "completed_cycle_interval_seconds": 86400,
    "busy_retry_seconds": 60,
    "state_directory": "dataset-versions"
  },
  "source_versioning": {
    "contract_version": 2,
    "logical_version": "complete_inventory_not_delta_chain",
    "physical_version": "reuse_immutable_parts_and_sha256_chunks",
    "file_chunk_bytes": 8388608,
    "reader_contract": "packed-v2-chunks",
    "shared_publication_activation": "explicit_reader_contract",
    "unchanged_content": "reuse_head_no_payload_write",
    "revisions_and_deletions": "new_inventory_preserve_old_references",
    "source_values_units_clocks": "preserve_exact_bytes",
    "legacy_payload_deletion": false,
    "local_versioning_grants_replication": false,
    "private_history": {
      "enabled": true,
      "relative_root": ".local-state/private-history",
      "shared_export": false,
      "nas_export": false,
      "source_retirement": false
    },
    "roots": {
      "data_tw_public": {"native_layout": "mutable_current_and_revision_sources", "target_grain": "source/dataset/symbol/period"},
      "data_tw_minute": {"native_layout": "daily_partitions_and_bounded_chunks", "target_grain": "provider/market/trade_date"},
      "data_tw_microstructure": {"native_layout": "append_parts_and_daily_views", "target_grain": "trade_date/event_kind/part"},
      "data_tw_shioaji_history": {"native_layout": "availability_receipts_and_contracts", "target_grain": "endpoint/symbol/period"},
      "data_taifex_public_history": {"native_layout": "raw_shards_and_normalized_views", "target_grain": "endpoint/period/revision"},
      "data_tw_futures": {"native_layout": "source_bundles_and_research_views", "target_grain": "product/session/trade_date"},
      "data_tw_index_futures": {"native_layout": "raw_partitions_and_current_views", "target_grain": "product/session/trade_date"},
      "data_tw_index_options_daily": {"native_layout": "daily_contracts_and_current_views", "target_grain": "product/expiry/trade_date"},
      "data_tw_index_derivatives_ticks": {"native_layout": "archives_and_append_captures", "target_grain": "trade_date/event_kind/part"},
      "data_finlab": {"native_layout": "content_addressed_whole_table_revisions", "target_grain": "dataset/schema/period_bucket"},
      "data_finmind": {"native_layout": "immutable_query_snapshots_and_receipts", "target_grain": "dataset/symbol/query_period/revision"},
      "data_tej": {"native_layout": "query_exports_and_normalized_shards", "target_grain": "table/query_period/revision"},
      "data_news": {"native_layout": "news_incremental_parts_v2_available", "target_grain": "table/copy_on_write_part"},
      "data_news_fulltext": {"native_layout": "immutable_bodies_and_transactional_queue", "target_grain": "provider/article/response_digest"},
      "data_binance": {"native_layout": "minute_parts_and_current_views", "target_grain": "venue/market/symbol/period"},
      "data_okx": {"native_layout": "minute_parts_and_current_views", "target_grain": "venue/market/symbol/period"},
      "data_bybit": {"native_layout": "minute_parts_and_current_views", "target_grain": "venue/market/symbol/period"},
      "data_binance_archive": {"native_layout": "immutable_monthly_partitions", "target_grain": "market/symbol/year_month"},
      "data_coinmetrics_community": {"native_layout": "raw_assets_and_vintage_views", "target_grain": "asset/metric/observation_period/revision"},
      "data_crypto_reference": {"native_layout": "observation_snapshots_and_latest", "target_grain": "endpoint/observed_at/payload_digest"},
      "data_crypto_historical_public": {"native_layout": "raw_revisions_and_current_views", "target_grain": "provider/endpoint/period/revision"},
      "data_dune_crypto": {"native_layout": "query_results_and_receipts", "target_grain": "query/execution/result_part"},
      "data_crypto_etf": {"native_layout": "filings_snapshots_and_normalized_views", "target_grain": "issuer/filing/period/revision"},
      "data_fred_crypto_macro": {"native_layout": "release_vintages", "target_grain": "series/realtime_period/observation_period"},
      "data_cftc_legacy": {"native_layout": "annual_source_archives_and_views", "target_grain": "report/year/revision"},
      "data_forex_frankfurter": {"native_layout": "official_history_and_symbol_views", "target_grain": "official_provider/base/quote/period"},
      "data_openBB": {"native_layout": "immutable_tasks_append_segments_and_final_views", "target_grain": "endpoint/append_only_segment"},
      "data_free_public": {"native_layout": "source_responses_and_current_views", "target_grain": "provider/endpoint/period/revision"},
      "data_public_economic": {"native_layout": "immutable_objects_and_receipt_history", "target_grain": "provider/endpoint/period/revision"},
      "data_keyed_public_catalogs": {"native_layout": "immutable_objects_and_catalog_receipts", "target_grain": "provider/endpoint/response_digest"},
      "data_yahoo": {"native_layout": "current_symbol_files", "target_grain": "market/symbol/period"},
      "data_peperstone": {"native_layout": "legacy_current_symbol_files", "target_grain": "provider/symbol/period"},
      "data_parquet": {"native_layout": "legacy_current_symbol_files", "target_grain": "provider/symbol/period"}
    }
  },
  "datasets": [
    {
      "id": "openbb",
      "root": "data_openBB",
      "l0": "data",
      "l1": "compact_l1",
      "l2": "compact",
      "partition_contract": "endpoint/append_only_segment",
      "query_catalog": "openbb_l1.duckdb",
      "policy": "incremental_l1_then_final_l2"
    },
    {
      "id": "tw_minute_research",
      "root": "data_tw_minute/research_dataset_developing_v5",
      "partition_contract": "trade_date=data.parquet",
      "policy": "preserve_daily_partitions"
    },
    {
      "id": "tw_microstructure",
      "root": "data_tw_microstructure/captures",
      "partition_contract": "trade_date/event_kind/append_parts",
      "policy": "compact_closed_trade_dates"
    },
    {
      "id": "tw_index_derivatives_ticks",
      "root": "data_tw_index_derivatives_ticks/shioaji_fop_captures",
      "partition_contract": "trade_date/event_kind/append_parts",
      "policy": "compact_closed_trade_dates"
    },
    {
      "id": "binance_public_archive",
      "root": "data_binance_archive/partitions",
      "partition_contract": "market/symbol/year_month",
      "policy": "preserve_download_parts_then_compact_symbol_year"
    },
    {
      "id": "yahoo_features",
      "root": "data_yahoo",
      "partition_contract": "market/symbol_features",
      "policy": "canonical_symbol_files_plus_rebuildable_panel_cache"
    }
  ],
  "safety": {
    "delete_l0_after_compaction": false,
    "atomic_publish_required": true,
    "pyarrow_polars_duckdb_row_parity_required": true,
    "schema_fingerprint_required": true,
    "source_manifest_required": true
  }
}
