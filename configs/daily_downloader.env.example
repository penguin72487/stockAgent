# Copy to configs/daily_downloader.env and edit local overrides if needed.
# Leave PYTHON_BIN empty to let scripts/runtime_env.sh auto-detect the active
# fintech env across /root, /home/user, or a local conda/mamba install.

PYTHON_BIN=

# market-daemon checks each market close window and runs each market at most once per local market day.
RUN_MODE=market-daemon
MARKET_CHECK_INTERVAL_SECONDS=300
MAX_CYCLES=0
FAIL_FAST=0
DAILY_PARALLEL_GROUPS=1
TEE_LOG=1

RUN_LOG_DIR=artifacts/daily_downloader
RUN_RECORD_FILE=artifacts/daily_downloader/daily_runs.tsv
LOCK_FILE=artifacts/daily_downloader/daily.lock
SCHEDULE_STATE_FILE=artifacts/daily_downloader/market_schedule.state
DAILY_DOWNLOADER_PID_FILE=artifacts/daily_downloader/daily_downloader.pid
DAILY_DOWNLOADER_LAUNCH_LOG=artifacts/daily_downloader/daily_downloader_daemon.log

WORKERS=16
ASSET_WORKERS=2
RETRIES=2
REPAIR_OVERLAP_DAYS=7
DAILY_STALE_MAX_LAG_DAYS=14
PRECHECK_FILE_TIMEOUT_SECONDS=20
REPAIR_SYMBOL_TIMEOUT_SECONDS=90

RUN_ALPACA_US=1
ALPACA_US_WORKERS=16
ALPACA_US_METADATA_WORKERS=4
ALPACA_US_BATCH_SIZE=500
ALPACA_US_RETRIES=4
ALPACA_US_TIMEOUT=30
# Basic=200 requests/minute; Algo Trader Plus=10000 requests/minute.
ALPACA_REQUESTS_PER_MINUTE=200
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_US_STEP_TIMEOUT_SECONDS=1800

RUN_YAHOO=0
YAHOO_ASSETS=""
YAHOO_DAILY_DISCOVER_SYMBOLS=1
YAHOO_DAILY_RETRY_KNOWN_MISSING_SYMBOLS=0
YAHOO_RETRY_BLACKLISTED_REPAIR_SYMBOLS=0
YAHOO_INCLUDE_US_DELISTED=1
YAHOO_STEP_TIMEOUT_SECONDS=900

RUN_TW_PUBLIC_DATA=1
TW_PUBLIC_CONFIG=configs/markets/tw_public.yaml
TW_PUBLIC_OUTPUT_DIR=data_tw_public
TW_PUBLIC_STOCKS_ROOT=data_tw_public/stocks
TW_PUBLIC_WORKERS=4
TW_PUBLIC_DATE_WORKERS=4
TW_PUBLIC_TIMEOUT=30
TW_PUBLIC_RETRIES=3
TW_PUBLIC_REQUEST_INTERVAL=
TW_PUBLIC_FLUSH_EVERY_DATES=250
TW_PUBLIC_DAILY_OVERLAP_DAYS=7
TW_PUBLIC_EMPTY_RECHECK_DAYS=30
TW_PUBLIC_SKIP_RAW=0
TW_PUBLIC_OHLCV_FALLBACK=yahoo
TW_PUBLIC_FALLBACK_START_DATE=2000-01-01
# Leave empty to use data_tw_public/fallback/yahoo_tw_stocks.
TW_PUBLIC_YAHOO_FALLBACK_DIR=
TW_PUBLIC_YAHOO_WORKERS=1
TW_PUBLIC_YAHOO_RETRIES=3
TW_PUBLIC_YAHOO_REQUEST_INTERVAL=1.5
TW_PUBLIC_SKIP_YAHOO_DOWNLOAD=0
TW_PUBLIC_PIPELINE_ATTEMPTS=3
TW_PUBLIC_PIPELINE_RETRY_SECONDS=60
RUN_TW_PUBLIC_FEATURES=1
TW_PUBLIC_FEATURE_PATH=data_tw_public/features/tw_public_stock_daily.parquet

FRANKFURTER_OUTPUT_DIR=data_yahoo/forex
FRANKFURTER_SYMBOLS_FILE=configs/forex_all_pairs_frankfurter.txt
FRANKFURTER_TIMEOUT=30
FRANKFURTER_REQUEST_INTERVAL=
FRANKFURTER_SKIP_MANIFEST=0
RUN_FRANKFURTER=1

RUN_PEPPERSTONE_GROUPS=0
PEPPERSTONE_WORKERS=8

RUN_CEX_PERP=1
# OKX/Bybit/Binance crypto perpetual updates use canonical one-minute bars.
OKX_WORKERS=16
OKX_REQUEST_INTERVAL=
OKX_MAX_RETRIES=8
BYBIT_WORKERS=16
BYBIT_REQUEST_INTERVAL=
BYBIT_MAX_RETRIES=8
BYBIT_CATEGORIES="linear inverse"
RUN_BINANCE_PERP=1
BINANCE_WORKERS=32
# Optional lower budget. The downloader always clamps to exchangeInfo.
BINANCE_REQUEST_WEIGHT_PER_MINUTE=
BINANCE_MAX_RETRIES=8
# Mark/index/premium, funding, OI, positioning, taker and basis are enabled by default.
BINANCE_FEATURE_WORKERS=32
CRYPTO_DAILY_MATERIALIZE_WORKERS=8
RUN_FREE_PUBLIC_CONTEXT=1
FREE_PUBLIC_CONTEXT_OUTPUT_DIR=data_free_public
RUN_CRYPTO_REFERENCE=1
CRYPTO_REFERENCE_OUTPUT_DIR=data_crypto_reference
RUN_DUNE_CRYPTO_HISTORY=0
DUNE_CRYPTO_OUTPUT_DIR=data_dune_crypto
DUNE_CRYPTO_WORKERS=3
RUN_CRYPTO_ETF_HISTORY=0
CRYPTO_ETF_OUTPUT_DIR=data_crypto_etf
CRYPTO_ETF_SEC_WORKERS=10
CRYPTO_ETF_ISSUER_WORKERS=4
CRYPTO_ETF_PRIMARY_DOCUMENTS=1
RUN_COINMETRICS_COMMUNITY=1
COINMETRICS_OUTPUT_DIR=data_coinmetrics_community
COINMETRICS_WORKERS=4
COINMETRICS_BATCH_ASSETS=50

# Full parquet audit is useful but expensive; keep opt-in for fast daily updates.
RUN_DATA_QUALITY_AUDIT=0
AUDIT_ROOTS="data_tw_public/stocks data_yahoo/us_stocks data_yahoo/forex data_okx/1m data_okx/daily data_bybit/1m data_bybit/daily data_binance/1m data_binance/daily data_crypto_reference data_forex_frankfurter data_peperstone"
AUDIT_OUTPUT_DIR=artifacts/data_quality
AUDIT_WORKERS=16
AUDIT_STALE_MAX_LAG_DAYS=14
AUDIT_DAILY_GAP_DAYS=10
AUDIT_INTRADAY_GAP_MULTIPLE=4

TW_CLOSE_TZ=Asia/Taipei
TW_CLOSE_TIME=13:40
US_CLOSE_TZ=America/New_York
US_CLOSE_TIME=16:20
FOREX_CLOSE_TZ=America/New_York
FOREX_CLOSE_TIME=17:10
CEX_CLOSE_TZ=UTC
CEX_CLOSE_TIME=00:10
