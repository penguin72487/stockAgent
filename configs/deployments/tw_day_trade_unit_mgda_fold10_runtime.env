# Exact fold_10 checkpoint model ABI. This selects its training adjoint;
# inference still uses the same fixed-row FP32 forward and no backward pass.
# Only the MGDA mode uses factorized_sparse_projection in the six-mode roster.
# Do not source into general training jobs: their selected experiment owns ABI.
STOCKAGENT_SPARSE_ADJOINT_BACKEND=cusparse_csr_transpose
STOCKAGENT_SPARSE_ADJOINT_ALGORITHM=6
