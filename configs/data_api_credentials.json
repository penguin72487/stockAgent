    {"id":"copernicus_cds","provider":"Copernicus Climate Data Store","location":"environment","required_names":["CDSAPI_URL","CDSAPI_KEY"],"requirement":"planned_p0","registration_url":"https://cds.climate.copernicus.eu/","notes":"ERA5；仍需在網站接受個別 dataset 條款。"},
    {"id":"copernicus_dataspace","provider":"Copernicus Data Space","location":"environment","required_names":["COPERNICUS_DATASPACE_CLIENT_ID","COPERNICUS_DATASPACE_CLIENT_SECRET"],"requirement":"planned","registration_url":"https://dataspace.copernicus.eu/","notes":"Sentinel 自動下載；若官方改用其他 OAuth flow，接入時更新契約。"},
    {"id":"un_comtrade","provider":"UN Comtrade","location":"environment","required_names":["UN_COMTRADE_API_KEY"],"requirement":"planned_p0","registration_url":"https://comtradeplus.un.org/","notes":"免費層配額與 bulk 條款在啟用前重新驗證。"},
    {"id":"sec_identity","provider":"SEC fair-access identity","location":"environment","any_of_names":["SEC_USER_AGENT","STOCKAGENT_CONTACT_EMAIL"],"optional_names":["SEC_USER_AGENT","STOCKAGENT_CONTACT_EMAIL"],"requirement":"active","registration_url":"https://www.sec.gov/os/accessing-edgar-data","notes":"不是 secret；至少提供可識別 User-Agent 或聯絡信箱。"},
