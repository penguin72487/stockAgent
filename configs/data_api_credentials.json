    {"id":"usda_nass","provider":"USDA NASS Quick Stats","location":"environment","required_names":["USDA_NASS_API_KEY"],"requirement":"planned","registration_url":"https://quickstats.nass.usda.gov/api","notes":"Quick Stats API key。"},
    {"id":"api_data_gov","provider":"API.Data.gov 共用金鑰","location":"environment","required_names":["API_DATA_GOV_KEY"],"requirement":"planned","registration_url":"https://api.data.gov/signup/","notes":"USDA FAS 等直接 API 可共用；OpenBB Congress 仍使用 OpenBB 專用欄位。"},
    {"id":"census","provider":"U.S. Census","location":"environment","required_names":["CENSUS_API_KEY"],"requirement":"planned","registration_url":"https://api.census.gov/data/key_signup.html","notes":"International Trade 與高量查詢使用。"},
    {"id":"openfigi","provider":"OpenFIGI","location":"environment","required_names":["OPENFIGI_API_KEY"],"requirement":"planned_p0","registration_url":"https://www.openfigi.com/","notes":"無 key 可查但限額較低；有 key 才適合批次 security mapping。"},
    {"id":"entsoe","provider":"ENTSO-E Transparency Platform","location":"environment","required_names":["ENTSOE_TOKEN"],"requirement":"planned","registration_url":"https://transparency.entsoe.eu/","notes":"Security token 需依官方流程申請。"},
