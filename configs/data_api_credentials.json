    {"id":"openbb_benzinga","provider":"OpenBB / Benzinga","location":"environment","required_names":["BENZINGA_API_KEY"],"openbb_field":"benzinga_api_key","requirement":"optional_paid_restricted","registration_url":"https://www.benzinga.com/apis/","notes":"新聞與日曆歷史通常受 entitlement 限制。"},
    {"id":"openbb_intrinio","provider":"OpenBB / Intrinio","location":"environment","required_names":["INTRINIO_API_KEY"],"openbb_field":"intrinio_api_key","requirement":"optional_paid_restricted","registration_url":"https://intrinio.com/","notes":"free feed 與 large-page/bulk 限制不同。"},
    {"id":"openbb_econdb","provider":"OpenBB / EconDB","location":"environment","required_names":["ECONDB_API_KEY"],"openbb_field":"econdb_api_key","requirement":"optional","registration_url":"https://www.econdb.com/api/","notes":"若方案不要求 key，保持空白並用 no-key 路徑。"},
    {"id":"openbb_tradingeconomics","provider":"OpenBB / Trading Economics","location":"environment","required_names":["TRADINGECONOMICS_API_KEY"],"openbb_field":"tradingeconomics_api_key","requirement":"optional_paid_restricted","registration_url":"https://tradingeconomics.com/api/","notes":"guest/free 與付費歷史範圍不同。"},
    {"id":"openbb_cftc_legacy","provider":"OpenBB / CFTC legacy token","location":"environment","required_names":["CFTC_APP_TOKEN"],"openbb_field":"cftc_app_token","requirement":"not_required","registration_url":"https://publicreporting.cftc.gov/","notes":"保留給 OpenBB 相容；現行 CFTC 下載器仍清除 runtime token 並使用匿名官方 API。"}
