{
  "schema_version": 1,
  "secret_values_permitted": false,
  "contract": {
    "environment_file": ".env",
    "environment_example": ".env.example",
    "environment_mode": "0600",
    "openbb_legacy_settings_file": "~/.openbb_platform/user_settings.json",
    "openbb_legacy_credentials_object": "credentials",
    "rule": "所有 API secret 的 canonical storage location 都是 repository .env；OpenBB legacy settings 僅作相容備援。狀態與面板只能發布 configured/missing/partial，不得發布值。"
  },
  "providers": [
    {"id":"shioaji","provider":"SinoPac Shioaji","location":"environment","required_names":["SHIOAJI_API_KEY","SHIOAJI_SECRET_KEY"],"requirement":"active","registration_url":"https://sinotrade.github.io/","notes":"行情與交易權限依永豐帳戶；正式交易 CA 另放 .env.trade。"},
    {"id":"alpaca","provider":"Alpaca","location":"environment","required_names":["APCA_API_KEY_ID","APCA_API_SECRET_KEY"],"requirement":"active","registration_url":"https://app.alpaca.markets/signup","notes":"免費方案與歷史/即時 entitlement 分開驗證。"},
    {"id":"alpha_vantage","provider":"Alpha Vantage","location":"environment","required_names":["ALPHAVANTAGE_API_KEY"],"requirement":"optional","registration_url":"https://www.alphavantage.co/support/#api-key","notes":"目前主要用於 listing-status 補充。"},
    {"id":"finnhub","provider":"Finnhub","location":"environment","required_names":["FINNHUB_API_KEY"],"requirement":"deferred","registration_url":"https://finnhub.io/register","notes":"免費方案存在，但端點 entitlement 與歷史深度需實測。"},
    {"id":"nasdaq_data_link","provider":"Nasdaq Data Link","location":"environment","required_names":["NASDAQ_DATA_LINK_API_KEY"],"requirement":"deferred","registration_url":"https://data.nasdaq.com/sign-up","notes":"免費資料集與付費資料集不可混為同一權限。"},
    {"id":"noaa_cdo","provider":"NOAA Climate Data Online","location":"environment","required_names":["NOAA_CDO_TOKEN"],"requirement":"planned","registration_url":"https://www.ncdc.noaa.gov/cdo-web/token","notes":"NWS 與 NCEI bulk 多數不需此 token；CDO API 才使用。"},
    {"id":"cwa","provider":"中央氣象署 CWA","location":"environment","required_names":["CWA_API_KEY"],"requirement":"planned_p0","registration_url":"https://opendata.cwa.gov.tw/userLogin","notes":"Authorization code；不把 key 放在 URL log。"},
    {"id":"moenv","provider":"環境部 MOENV","location":"environment","required_names":["MOENV_API_KEY"],"requirement":"planned_p0","registration_url":"https://data.moenv.gov.tw/","notes":"空品與環境資料 API key。"},
    {"id":"nasa_firms","provider":"NASA FIRMS","location":"environment","required_names":["NASA_FIRMS_MAP_KEY"],"requirement":"planned","registration_url":"https://firms.modaps.eosdis.nasa.gov/api/map_key/","notes":"免費 MAP_KEY；仍須遵守 transaction window。"},
