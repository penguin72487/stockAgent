    {"id":"coinglass","provider":"CoinGlass","location":"environment","required_names":["COINGLASS_API_KEY"],"requirement":"deferred","registration_url":"https://www.coinglass.com/pricing","notes":"有 key 不代表免費端點足夠；先做 entitlement probe。"},
    {"id":"coinmarketcap","provider":"CoinMarketCap","location":"environment","required_names":["COINMARKETCAP_API_KEY"],"requirement":"fallback","registration_url":"https://coinmarketcap.com/api/","notes":"只作 CoinGecko fallback/QA，避免重複 canonical facts。"},
    {"id":"openbb_fred","provider":"OpenBB / FRED","location":"environment","required_names":["FRED_API_KEY"],"openbb_field":"fred_api_key","requirement":"active","registration_url":"https://fred.stlouisfed.org/docs/api/api_key.html","notes":"下載器把 .env 值注入 OpenBB runtime；legacy user settings 僅作備援。"},
    {"id":"openbb_bls","provider":"OpenBB / BLS","location":"environment","required_names":["BLS_API_KEY"],"openbb_field":"bls_api_key","requirement":"active","registration_url":"https://data.bls.gov/registrationEngine/","notes":"註冊版提高每日、series 與年份額度。"},
    {"id":"openbb_eia","provider":"OpenBB / EIA","location":"environment","required_names":["EIA_API_KEY"],"openbb_field":"eia_api_key","requirement":"active","registration_url":"https://www.eia.gov/opendata/register.php","notes":"repository .env 是 canonical location。"},
    {"id":"openbb_congress","provider":"OpenBB / Congress.gov","location":"environment","required_names":["CONGRESS_GOV_API_KEY"],"openbb_field":"congress_gov_api_key","requirement":"active","registration_url":"https://api.congress.gov/sign-up/","notes":"repository .env 是 canonical location。"},
